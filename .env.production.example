# Set these as Railway service Variables (Project → your service → Variables).
# Do NOT commit a real .env with secrets — Railway injects these at runtime,
# no .env file is deployed with the image.

# --- Required, no safe default ---
APP_NAME=PharmacyLink
APP_ENV=production
APP_KEY=                      # generate locally: php artisan key:generate --show
APP_DEBUG=false
APP_URL=                      # e.g. https://your-app.up.railway.app

# --- Database (MySQL plugin) ---
# Add Railway's MySQL plugin to the project, then reference its variables here
# instead of typing values, e.g. DB_HOST=${{MySQL.MYSQLHOST}}
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session / cache / queue ---
# database-backed, so no Redis add-on needed; the `sessions`/`cache`/`jobs`
# tables already exist via migrations.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
# No ShouldQueue notifications exist in this app today, so `php artisan
# queue:work` isn't required. If you add queued jobs later, add a second
# Railway service running that command.

# --- Mail (OTP / notifications) ---
# MAIL_MAILER=log just writes emails to the log — fine for a demo, but the
# email-verification OTP flow won't actually reach anyone's inbox. Switch to
# a real provider (Resend and Postmark both have free tiers) once ready:
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# RESEND_KEY=
# POSTMARK_TOKEN=

# --- Gemini (AI chat + prescription scanner) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Misc ---
LOG_CHANNEL=stack
LOG_LEVEL=error
FILESYSTEM_DISK=local          # see caveat below
BCRYPT_ROUNDS=12

# --- Deploy behavior (read by docker/entrypoint.sh, not Laravel) ---
# RUN_MIGRATIONS=false         # uncomment to stop auto-running migrations on every deploy
# PORT                         # set automatically by Railway — do not set manually

# ------------------------------------------------------------------
# KNOWN CAVEAT: ephemeral disk
# ------------------------------------------------------------------
# Railway's filesystem is not persistent across redeploys. Anything written
# to storage/app/public (pharmacy logos, license/certificate uploads,
# prescription scans) will be lost the next time you deploy. For a demo this
# is often fine; for real use, either:
#   - attach a Railway Volume mounted at /var/www/html/storage/app/public, or
#   - switch FILESYSTEM_DISK to an S3-compatible bucket (Cloudflare R2 and
#     Backblaze B2 both have free tiers) and update config/filesystems.php.
